LAB_DB_URL=jdbc:postgresql://localhost:55433/syskata_labs
LAB_DB_USER=REPLACE_LOCALLY
LAB_DB_PASSWORD=REPLACE_LOCALLY
LAB_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_SERVICE_CREDENTIAL
LAB_KUBECONFIG=/private/path/controller.kubeconfig
LAB_TERMINAL_IMAGE=REPLACE_WITH_VERIFIED_OC_IMAGE_DIGEST
# Use the API address resolved inside the cluster (split DNS may differ).
LAB_API_CIDR=REPLACE_WITH_POD_VISIBLE_API_IP/32
LAB_ROUTE_DOMAIN=REPLACE_WITH_CLUSTER_APPS_DOMAIN

# Set after installing the evaluator identity; mount its credentials only in the worker.
LAB_EVALUATOR_NAMESPACE=REPLACE_WITH_CONTROL_NAMESPACE
